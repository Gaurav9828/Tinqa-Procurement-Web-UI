#!/bin/sh
# Opt-in (once per clone): git config core.hooksPath .githooks
# Every push is then built and tested first: quality gate, dev build, end-to-end tests and call budgets.
# The UAT/production builds run every check again, strictly, whether or not this hook is used.
set -e
echo "pre-push: npm run build:dev (quality gate, build, end-to-end tests)..."
npm run --silent build:dev
